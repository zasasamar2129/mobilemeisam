{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:sim-financial": "node --import tsx tests/simFinancial.test.ts",
    "test:task-auth": "node --import tsx tests/taskAuthorization.test.ts",
    "test:task-api": "node --import tsx tests/taskApi.test.ts",
    "test:deed-transfer": "node --import tsx tests/deedTransfer.test.ts",
    "test:sim-lead-dates": "node --import tsx tests/simLeadDates.test.ts",
    "test:sync-task-scope": "node --import tsx tests/syncTaskScope.test.ts",
    "test:deed-enforcement": "node --import tsx tests/deedServerEnforcement.test.ts",
    "test:deed-reminders": "node --import tsx tests/deedReminders.test.ts",
    "test:task-grouping": "node --import tsx tests/taskGrouping.test.ts",
    "test": "npm run test:sim-financial && npm run test:task-auth && npm run test:task-api && npm run test:task-grouping && npm run test:deed-transfer && npm run test:deed-reminders && npm run test:sim-lead-dates && npm run test:sync-task-scope && npm run test:deed-enforcement"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jalaali-js": "^2.0.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
